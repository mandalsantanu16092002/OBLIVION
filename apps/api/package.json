{
  "name": "@onboardiq/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/migrate.ts --reset && tsx src/db/seed.ts",
    "seed:eval": "tsx src/db/seed.ts --eval-only",
    "batch": "tsx src/cli/batch.ts",
    "batch:sample": "tsx src/cli/batch.ts --set sample --out ../../output/decisions_output_sample.csv",
    "batch:eval": "tsx src/cli/batch.ts --set eval --out ../../output/decisions_output.csv",
    "batch:ai": "tsx src/cli/batch.ts --set eval --extraction ../../output/extraction_output.csv --out ../../output/ai_decisions_output.csv",
    "verify:sample": "tsx src/cli/batch.ts --set sample --verify",
    "openapi": "tsx src/cli/export-openapi.ts"
  },
  "dependencies": {
    "@onboardiq/rules-engine": "*",
    "@onboardiq/shared": "*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
