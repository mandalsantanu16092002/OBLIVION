{
  "openapi": "3.0.3",
  "info": {
    "title": "OnboardIQ API",
    "version": "1.0.0",
    "description": "KYC onboarding, document verification and watchlist screening with maker-checker. All data synthetic."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Register": {
        "type": "object",
        "required": [
          "full_name",
          "email",
          "password"
        ],
        "properties": {
          "full_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "ApplicationInput": {
        "type": "object",
        "required": [
          "full_name",
          "dob",
          "gender",
          "pan_number",
          "aadhaar_last4",
          "mobile",
          "email",
          "address",
          "city",
          "state",
          "pincode",
          "occupation_code",
          "annual_income",
          "kyc_consent"
        ],
        "properties": {
          "full_name": {
            "type": "string"
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "enum": [
              "M",
              "F",
              "O"
            ]
          },
          "pan_number": {
            "type": "string",
            "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$"
          },
          "aadhaar_last4": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "mobile": {
            "type": "string",
            "pattern": "^[6-9][0-9]{9}$"
          },
          "email": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "pincode": {
            "type": "string",
            "pattern": "^[1-9][0-9]{5}$"
          },
          "occupation_code": {
            "type": "string"
          },
          "annual_income": {
            "type": "integer"
          },
          "kyc_consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "FieldCorrection": {
        "type": "object",
        "required": [
          "doc_id",
          "field_name",
          "new_value",
          "reason"
        ],
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "field_name": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "expected_version": {
            "type": "integer"
          }
        }
      },
      "Recommendation": {
        "type": "object",
        "required": [
          "recommendation",
          "comment"
        ],
        "properties": {
          "recommendation": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT",
              "REQUEST_RESUBMISSION"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 10
          },
          "expected_version": {
            "type": "integer"
          }
        }
      },
      "CheckerDecision": {
        "type": "object",
        "required": [
          "decision",
          "comment"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT",
              "SEND_BACK"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 10
          },
          "expected_version": {
            "type": "integer"
          }
        }
      },
      "ConfigPatch": {
        "type": "object",
        "additionalProperties": true,
        "example": {
          "name_match_threshold": 0.85
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register an applicant account",
        "description": "Public",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Register"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Log in (returns a JWT)",
        "description": "Public",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Current user",
        "description": "Roles: any",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Role not allowed"
          }
        }
      }
    },
    "/reference/meta": {
      "get": {
        "summary": "Document types, statuses, reason codes, business date",
        "description": "Public",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/reference/occupations": {
      "get": {
        "summary": "Occupation list",
        "description": "Public",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health of API, database and AI service",
