# Copy to .env (repo root). Every value has a working local default.

# PostgreSQL (docker compose up -d db  starts one with these credentials)
DATABASE_URL=postgres://onboardiq:onboardiq@localhost:5432/onboardiq
# Used by the API test suite (reset on every run)
TEST_DATABASE_URL=postgres://onboardiq:onboardiq@localhost:5432/onboardiq_test

PORT=4000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Service key: the backend presents it to the AI service and the mock core-banking API
SERVICE_KEY=dev-service-key

# Extraction provider: mock | ai   (can also be switched at runtime in Rules & watchlists)
EXTRACTION_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=10000

# Empty = call the mock core-banking handler in-process. Set to use the HTTP API:
# CORE_BANKING_URL=http://localhost:4000/internal/core-banking
CORE_BANKING_URL=

# Business date used as application_date for new applications. The data-pack documents are
# dated Jan-Feb 2026, so 2026-03-05 keeps their address proofs within 90 days. Empty = today (IST).
DEMO_BUSINESS_DATE=2026-03-05

CORS_ORIGIN=http://localhost:5173,http://localhost:8080
STORAGE_DIR=storage/documents

# Optional: AI-5 reviewer summary with an LLM (otherwise a template summary is used)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
